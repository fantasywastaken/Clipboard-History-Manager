<Window x:Class="Fantasy.ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard History"
        Width="620"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Visibility="Hidden"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="7,7,0,0"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <TextBlock Text="C"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Clipboard History"
                                   Margin="10,0,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountLabel"
                                   Text=""
                                   Margin="10,0,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ClearButton"
                                Content="Clear Unpinned"
                                Style="{StaticResource IconButton}"
                                Click="ClearButton_Click"
                                Margin="0,0,6,0"/>
                        <Button x:Name="HideButton"
                                Content="✕"
                                Style="{StaticResource IconButton}"
                                FontSize="14"
                                Click="HideButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundBrush}"
                    Padding="16,12,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Padding="34,7,10,7"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"/>
                        <TextBlock Text="🔍"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontSize="13"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search clipboard history..."
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="34,0,0,0"
                                   FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16,0,16,8">
                <ListBox x:Name="HistoryList"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         KeyDown="HistoryList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <Button Content="{Binding PinGlyph}"
                                            ToolTip="{Binding PinTooltip}"
                                            Style="{StaticResource IconButton}"
                                            FontSize="15"
                                            Padding="6,1"
                                            Tag="{Binding}"
                                            Click="PinButton_Click">
                                        <Button.Foreground>
                                            <SolidColorBrush Color="{StaticResource PinColor}"/>
                                        </Button.Foreground>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TimestampDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                                </StackPanel>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="ContextCopy_Click"/>
                                        <MenuItem Header="Pin / Unpin" Click="ContextPin_Click"/>
                                        <MenuItem Header="Delete" Click="ContextDelete_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="EmptyState" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📋"
                                   FontSize="42"
                                   HorizontalAlignment="Center"
                                   Opacity="0.45"/>
                        <TextBlock Text="No clipboard history yet"
                                   Margin="0,12,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="Copy something to get started"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,7,7"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Enter / Double-click to paste  ·  Esc to hide"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="Ctrl + Shift + V"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
